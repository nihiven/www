<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Open Graph Tags for Rich Previews (GroupMe, Discord, etc.) -->
  <meta property="og:type" content="video.other" />
  <meta property="og:title" content="<%= filename %>" />
  <meta property="og:description" content="Watch this video clip" />
  <meta property="og:site_name" content="Clips" />

  <meta property="og:video" content="https://clips.jeb.rip<%= videoUrl %>" />
  <meta property="og:video:url" content="https://clips.jeb.rip<%= videoUrl %>" />
  <meta property="og:video:secure_url" content="https://clips.jeb.rip<%= videoUrl %>" />
  <meta property="og:video:type" content="video/mp4" />
  <meta property="og:video:width" content="1280" />
  <meta property="og:video:height" content="720" />

  <meta property="og:image" content="https://clips.jeb.rip<%= thumbnailUrl %>" />
  <meta property="og:image:secure_url" content="https://clips.jeb.rip<%= thumbnailUrl %>" />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1280" />
  <meta property="og:image:height" content="720" />

  <!-- Twitter Card Tags -->
  <meta name="twitter:card" content="player" />
  <meta name="twitter:title" content="<%= filename %>" />
  <meta name="twitter:description" content="Watch this video clip" />
  <meta name="twitter:image" content="https://clips.jeb.rip<%= thumbnailUrl %>" />
  <meta name="twitter:player" content="https://clips.jeb.rip<%= videoUrl %>" />
  <meta name="twitter:player:width" content="1280" />
  <meta name="twitter:player:height" content="720" />

  <title><%= filename %> - Clips</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #0a0a0a;
      color: #e0e0e0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 2rem;
    }

    header {
      margin-bottom: 2rem;
      text-align: center;
    }

    h1 {
      color: #fff;
      font-size: 1.5rem;
      margin-bottom: 0.5rem;
      word-break: break-all;
    }

    nav a {
      color: #60a5fa;
      text-decoration: none;
      font-size: 0.9rem;
      margin: 0 0.5rem;
    }

    nav a:hover {
      text-decoration: underline;
    }

    .container {
      width: 100%;
      max-width: 1280px;
    }

    .video-wrapper {
      position: relative;
      width: 100%;
      background: #000;
      border-radius: 12px;
      overflow: hidden;
      margin-bottom: 1.5rem;
    }

    .video-wrapper video {
      width: 100%;
      height: auto;
      display: block;
    }

    .video-info {
      background: #111;
      padding: 1.5rem;
      border-radius: 12px;
    }

    .video-meta {
      color: #888;
      font-size: 0.9rem;
      margin-bottom: 1rem;
    }

    .actions {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .btn {
      padding: 0.75rem 1.5rem;
      border: none;
      border-radius: 6px;
      font-size: 0.9rem;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      transition: background 0.2s;
      font-weight: 500;
    }

    .btn-primary {
      background: #60a5fa;
      color: white;
    }

    .btn-primary:hover {
      background: #3b82f6;
    }

    .btn-secondary {
      background: #333;
      color: #e0e0e0;
    }

    .btn-secondary:hover {
      background: #444;
    }
  </style>
</head>
<body>
  <header>
    <h1><%= filename %></h1>
    <nav>
      <a href="/">&larr; Upload</a>
      <a href="/videos">All Clips</a>
    </nav>
  </header>

  <div class="container">
    <div class="video-wrapper">
      <video controls autoplay>
        <source src="<%= videoUrl %>" type="video/mp4">
        Your browser does not support the video tag.
      </video>
    </div>

    <div class="video-info">
      <div class="video-meta">
        <%= size %> MB • <%= new Date(date).toLocaleDateString() %>
      </div>
      <div class="actions">
        <button class="btn btn-primary" onclick="copyUrl()">Copy Share Link</button>
        <a href="<%= videoUrl %>" download class="btn btn-secondary">Download</a>
        <a href="/videos" class="btn btn-secondary">Back to Gallery</a>
      </div>
    </div>
  </div>

  <script>
    function copyUrl() {
      const url = window.location.href;
      navigator.clipboard.writeText(url).catch(() => {
        console.error('Clipboard API not available');
      });
    }
  </script>
</body>
</html>
